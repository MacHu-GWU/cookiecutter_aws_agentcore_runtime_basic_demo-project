// Copy to config/config-dev-secret.json5 (git-ignored; same for tst / prd) and fill in real values.
// Secrets of one environment, merged last, overriding every other file.
// Every key must be a field of Config (config_00_main.py).
{
  // The account this environment deploys to; every stack is bound to it.
  aws_account_id: "123456789012",
  // The SQLAlchemy URL of the power plant database. A secret in a real project (it holds
  // the password); the demo uses an in-memory SQLite database, seeded on startup.
  db_connection_string: "sqlite+pysqlite:///:memory:",
}
