{
  "name": "AcRtDemo",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "PowerPlantMcp",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/PowerPlantMcp",
      "runtimeVersion": "PYTHON_3_12",
      "protocol": "MCP",
      "envVars": [
        {
          "name": "IS_AGENTCORE_RUNTIME",
          "value": "true"
        }
      ]
    },
    {
      "name": "SiteAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/SiteAgent",
      "runtimeVersion": "PYTHON_3_12",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "IS_AGENTCORE_RUNTIME",
          "value": "true"
        }
      ]
    }
  ]
}
